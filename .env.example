# Copy to .env.local for development. Real secrets never go into the repository.
DATABASE_URL=postgres://agrosoy:agrosoy@localhost:5434/agrosoy
# Only for `pnpm test:integration`; its tables are emptied between tests.
TEST_DATABASE_URL=postgres://agrosoy:agrosoy@localhost:5434/agrosoy_test
# Session signing secret (32+ characters). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=development-only-secret-change-me-0123456789
BETTER_AUTH_URL=http://localhost:3000
