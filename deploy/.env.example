# Copy to .env in the environment's folder on the server and fill in real values there only.
# Then: chmod 600 .env
ENVIRONMENT=staging
# Image tag to run: "main" (latest) or a commit SHA to pin or roll back.
IMAGE_TAG=main
# Docker network shared with the server's nginx.
PROXY_NETWORK=server-network
# Letters and digits only, it goes inside a URL. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Session signing secret, different per environment. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Address people open in the browser; sign-in only works from this origin.
# Through the SSH tunnel, before the domain exists: http://localhost:3100
# Once the domain has its certificate: https://agrosoy.solution-services-tech.com
BETTER_AUTH_URL=http://localhost:3100
