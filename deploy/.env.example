# Copy to .env in the environment's folder on the server and fill in real values there only.
# Then: chmod 600 .env
ENVIRONMENT=staging
# Image tag to run: "main" (latest) or a commit SHA to pin or roll back.
IMAGE_TAG=main
# Docker network shared with the server's nginx.
PROXY_NETWORK=server-network
# Letters and digits only, it goes inside a URL. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Session signing secret, different per environment. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Phase A: reached by IP and port, no domain yet (README.md) ---
# Also loads compose.ip.yaml, which publishes the app on PUBLIC_PORT. Remove both lines in phase B.
COMPOSE_FILE=compose.yaml:compose.ip.yaml
PUBLIC_PORT=3100
# The address people open in the browser; sign-in only works from this exact origin.
BETTER_AUTH_URL=http://38.242.145.246:3100

# --- Phase B: with the domain and its certificate ---
# BETTER_AUTH_URL=https://agrosoy.solution-services-tech.com
