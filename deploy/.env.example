# Copy to .env in the environment's folder on the VPS and fill in real values there only.
ENVIRONMENT=staging
# Image tag to run: "main" (latest) or a commit SHA to pin or roll back.
IMAGE_TAG=main
# Local port the reverse proxy forwards to; staging and production need different ones.
APP_PORT=3100
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Session signing secret, different per environment. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public HTTPS address of this environment.
BETTER_AUTH_URL=https://staging.agrosoy.example.com
